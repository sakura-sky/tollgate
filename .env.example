# SPDX-License-Identifier: MIT
# SPDX-FileCopyrightText: 2026 Andrew Stevens
#
# Copy to .env for local dev. Keys map to the layered config in src/config.rs;
# nested fields use double underscores.

TOLLGATE_HTTP__BIND=0.0.0.0:8080

# Bounds Tollgate's OWN local routes (health, metrics, console), not the provider
# call: those routes do their own work and should never run long, so a short
# timeout turns a stuck dependency into a 503 instead of a hung connection. The
# proxied routes are deliberately outside it and use
# TOLLGATE_PROVIDERS__REQUEST_TIMEOUT below, because an LLM response can
# legitimately take minutes.
TOLLGATE_HTTP__REQUEST_TIMEOUT=60s
# How long to keep draining in-flight requests after SIGTERM (or Ctrl-C). A
# request cut off here never settles its reservation, so this wants to be long
# enough for a buffered call to finish, and it is what your platform's own
# termination grace period must exceed.
TOLLGATE_HTTP__SHUTDOWN_GRACE=15s

TOLLGATE_DATABASE__URL=postgres://tollgate:tollgate@127.0.0.1:5432/tollgate
# Postgres pool. Every request does one key lookup and one ledger insert, and
# each open console adds one spend query per budget plus one usage query every
# second, so the pool is shared between the request path and the console: a
# handful of consoles left open can starve the traffic that pays for them. Size
# it against both, and against your Postgres connection limit.
TOLLGATE_DATABASE__MAX_CONNECTIONS=10
# How long a request waits for a free connection before giving up. It fails the
# key lookup, which surfaces to the client as a 401, so keep it short enough to
# fail visibly rather than queue.
TOLLGATE_DATABASE__ACQUIRE_TIMEOUT=5s
# Redis OR Valkey (wire-compatible); Memorystore for Valkey is cheaper on GCP.
# The scheme must be `redis://`. This build compiles the Valkey client without a
# TLS feature, so a `rediss://` URL is refused at startup rather than quietly
# downgraded to cleartext: a connection you believe is encrypted and is not is
# worse than one you know is not. AUTH credentials, if the instance has them, go
# in this URL. See SECURITY.md for what that leaves exposed.
TOLLGATE_REDIS__URL=redis://127.0.0.1:6379
TOLLGATE_TELEMETRY__LOG_FILTER=info,tollgate=debug
# Leave unset to disable OTLP export. To send traces to a local collector:
# TOLLGATE_TELEMETRY__OTLP_ENDPOINT=http://127.0.0.1:4317

# How often to reload budgets and prices from Postgres so `admin budget set` /
# `price set` apply without a restart. Set 0s to disable (read only at startup).
TOLLGATE_RELOAD__INTERVAL=15s

# How long to keep usage_events rows. The ledger is monthly-partitioned; older
# partitions are dropped (it is append-only, so no DELETE). 0s keeps everything.
# If the ledger is your billing record, set 0s or export partitions before they
# age out: the default quietly deletes your billing history every quarter.
TOLLGATE_RETENTION__WINDOW=90d

# Display currency (ISO 4217). The money path is currency-agnostic; this is a label.
TOLLGATE_BILLING__CURRENCY=USD

# Total time allowed for ONE buffered upstream provider call. Deliberately
# separate from TOLLGATE_HTTP__REQUEST_TIMEOUT, which bounds Tollgate's own
# local routes (health, console): those should finish in seconds, while a
# non-streaming LLM sends no headers until generation completes and a large
# response legitimately takes minutes.
#
# When this expires the request is treated as POSSIBLY BILLED and charged its
# reservation, recorded as `estimated`, because the provider may have generated
# a full response Tollgate never read. Setting it too low therefore over-charges
# rather than failing cheaply. Streaming ignores it and uses the idle and
# max-duration guards instead.
TOLLGATE_PROVIDERS__REQUEST_TIMEOUT=600s

# Fallback pricing for prompt-cache token classes the operator has not priced,
# as a multiple of the model's own input rate in integer PER-MILLE (1000 = 1.0x).
# Integer so no floating point touches the money path.
#
# These apply only where `model_prices.cache_read/write_per_1m_micros` is NULL.
# They deliberately OVER-charge: a real cache read costs about a tenth of the
# input rate, so leaving a model unpriced can over-count its prompt leg by
# roughly 10x. Set real rates with:
#   tollgate admin price set --provider X --model Y \
#     --input-per-1m .. --output-per-1m .. \
#     --cache-read-per-1m .. --cache-write-per-1m ..
#
# Values below 1000 are REJECTED at boot: guessing downward on a rate nobody
# supplied is a silent under-charge, which this proxy never does.
# The write default is 2000 because a provider can charge up to 2x the input
# rate to write a cache entry.
TOLLGATE_BILLING__CACHE_READ_FALLBACK_PERMILLE=1000
TOLLGATE_BILLING__CACHE_WRITE_FALLBACK_PERMILLE=2000

# Long-context re-rating.
#
# Several current models bill the WHOLE request at a higher rate once the prompt
# crosses a threshold (commonly 200k tokens, commonly 2x). A price is one rate
# per class and cannot express a rate that changes with size, so without this a
# large request is UNDER-charged by the tier multiple, and under-charging is the
# one direction this proxy may never err in.
#
# Same posture as the cache-class fallback above: an unmodelled pricing dimension
# costs more, not less. The multiple applies to the whole prompt rather than just
# the excess, because that is how providers bill it, and it is applied to the
# RESERVATION as well as the settlement so the two cannot diverge on exactly the
# largest requests.
#
# OPT-IN. The default multiple is 1000 (1.0x), i.e. no re-rating, because a
# given model may not tier at all and defaulting to an uplift would invent a
# charge, as well as breaking the definition of the unit: one million tokens
# would no longer cost the per-million rate.
#
# With the default, a prompt above the threshold is LOGGED as a possible
# under-charge rather than silently re-rated. Set the multiple to opt in once
# you know your model tiers (2000 = 2.0x is the common case).
#
# Threshold 0 disables re-rating and the under-charge warning, deployment-wide.
# Setting it to 0 while a multiple below is above 1000 is REFUSED at boot: that
# pair re-rates nothing and warns about nothing, so it would look configured and
# do neither.
# A single model can be disabled the same way with
# `admin price set --long-context-threshold 0`, which keeps the check on for
# every other model and drops any multiples that model was carrying, since they
# could not apply. To send a model back to the deployment default instead, use
# `admin price set --clear-long-context`.
# Multiples outside 1000 to 10000 are REJECTED at boot,
# whatever the threshold: below 1000 would make a long request cheaper than a
# short one, and a units mistake (2000000 meaning 2x) would saturate the money
# path, which no budget counter can recover from.
# These are the DEPLOYMENT-WIDE fallback. Per-model values belong on the price
# row, because a gateway fronting one model that tiers and one that bills flat
# would otherwise have to choose which to get wrong:
#   tollgate admin price set --provider X --model Y \
#     --input-per-1m .. --output-per-1m .. \
#     --long-context-threshold 200000 \
#     --long-context-input-permille 2000 \
#     --long-context-output-permille 1500
#
# Input and output multiples are separate because real tiers move them by
# different amounts (commonly 2x input, 1.5x output). Re-rating only the prompt
# still under-charges the output leg of every long request.
TOLLGATE_BILLING__LONG_CONTEXT_THRESHOLD_TOKENS=200000
TOLLGATE_BILLING__LONG_CONTEXT_MULTIPLE_PERMILLE=1000
TOLLGATE_BILLING__LONG_CONTEXT_OUTPUT_MULTIPLE_PERMILLE=1000
# Server-side pepper for API-key HMAC. MUST be a fixed secret (>=16 bytes) in
# production, and the SAME value for `serve` and `admin key issue`. Not secret here.
TOLLGATE_SECURITY__API_KEY_PEPPER=dev-only-change-me-please-16+

# Providers. admission: 'fast' (default, low latency, bounded best-effort) or
# 'exact' (strict pre-flight token count, one extra call per request).
TOLLGATE_PROVIDERS__ADMISSION=fast
# Register the built-in mock provider in `serve` (local end-to-end testing only).
TOLLGATE_PROVIDERS__ENABLE_MOCK=false
# Anthropic. Native clients (the Anthropic SDK, LiteLLM, the ADK) point at
# /v1/messages, which accepts x-api-key so the SDK works unchanged. The legacy
# enveloped route /v1/anthropic/messages still resolves but is not SDK-compatible:
# it wraps successes in a {"response":..,"tollgate":..} envelope and does not read
# x-api-key.
TOLLGATE_PROVIDERS__ANTHROPIC__ENABLED=false
# TOLLGATE_PROVIDERS__ANTHROPIC__API_KEY=sk-ant-...
# Vertex/Gemini (Workload Identity token by default; set ACCESS_TOKEN for local tests):
TOLLGATE_PROVIDERS__VERTEX__ENABLED=false
# TOLLGATE_PROVIDERS__VERTEX__PROJECT=my-gcp-project
# TOLLGATE_PROVIDERS__VERTEX__LOCATION=us-central1

# OpenAI-compatible endpoint: serve /v1/chat/completions so OpenAI clients, LiteLLM,
# and ADK agents can route through Tollgate (auth via Authorization: Bearer <key>).
TOLLGATE_PROVIDERS__OPENAI__ENABLED=false
# upstream: 'vertex' (front Vertex's OpenAI endpoint for Gemini; reuses the
# VERTEX__PROJECT / VERTEX__LOCATION above) or 'custom' (any OpenAI-compatible base).
TOLLGATE_PROVIDERS__OPENAI__UPSTREAM=vertex
# For upstream=custom:
# TOLLGATE_PROVIDERS__OPENAI__BASE_URL=https://api.openai.com/v1
# TOLLGATE_PROVIDERS__OPENAI__API_KEY=sk-...

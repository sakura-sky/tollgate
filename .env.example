#
# Copy to .env for local dev. Keys map to the layered config in src/config.rs;
# nested fields use double underscores.

TOLLGATE_HTTP__BIND=0.0.0.0:8080
TOLLGATE_DATABASE__URL=postgres://tollgate:tollgate@127.0.0.1:5432/tollgate
# Redis OR Valkey (wire-compatible); Memorystore for Valkey is cheaper on GCP.
TOLLGATE_REDIS__URL=redis://127.0.0.1:6379
TOLLGATE_TELEMETRY__LOG_FILTER=info,tollgate=debug
# Leave unset to disable OTLP export. To send traces to a local collector:
# TOLLGATE_TELEMETRY__OTLP_ENDPOINT=http://127.0.0.1:4317

# How often to reload budgets and prices from Postgres so `admin budget set` /
# `price set` apply without a restart. Set 0s to disable (read only at startup).
TOLLGATE_RELOAD__INTERVAL=15s

# Display currency (ISO 4217). The money path is currency-agnostic; this is a label.
TOLLGATE_BILLING__CURRENCY=USD
# Server-side pepper for API-key HMAC. MUST be a fixed secret (>=16 bytes) in
# production, and the SAME value for `serve` and `admin key issue`. Not secret here.
TOLLGATE_SECURITY__API_KEY_PEPPER=dev-only-change-me-please-16+

# Providers. admission: 'fast' (default, low latency, bounded best-effort) or
# 'exact' (strict pre-flight token count, one extra call per request).
TOLLGATE_PROVIDERS__ADMISSION=fast
# Register the built-in mock provider in `serve` (local end-to-end testing only).
TOLLGATE_PROVIDERS__ENABLE_MOCK=false
# Anthropic (native pass-through to /v1/anthropic/messages):
TOLLGATE_PROVIDERS__ANTHROPIC__ENABLED=false
# TOLLGATE_PROVIDERS__ANTHROPIC__API_KEY=sk-ant-...
# Vertex/Gemini (Workload Identity token by default; set ACCESS_TOKEN for local tests):
TOLLGATE_PROVIDERS__VERTEX__ENABLED=false
# TOLLGATE_PROVIDERS__VERTEX__PROJECT=my-gcp-project
# TOLLGATE_PROVIDERS__VERTEX__LOCATION=us-central1
